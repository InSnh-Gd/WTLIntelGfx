+static void adjust_idledly(struct xe_hw_engine *hwe)
+{
+	struct xe_gt *gt = hwe->gt;
+	u32 idledly, maxcnt, delay, idledly_units_ps;
+	u64 maxcnt_ps;
+
+	if (IS_SRIOV_VF(gt_to_xe(gt)) || !XE_WA(gt, 16023105232))
+		return;
+
+	idledly_units_ps = 8 * gt->info.timestamp_base;
+	if (xe_gt_WARN_ON(gt, !idledly_units_ps))
+		return;
+
+	idledly = xe_mmio_read32(&gt->mmio, RING_IDLEDLY(hwe->mmio_base));
+	maxcnt = xe_mmio_read32(&gt->mmio, RING_PWRCTX_MAXCNT(hwe->mmio_base));
+	maxcnt = REG_FIELD_GET(IDLE_WAIT_TIME, maxcnt);
+	/* No nonnegative IDLEDLY can be strictly lower than a zero MAXCNT. */
+	if (xe_gt_WARN_ON(gt, !maxcnt))
+		return;
+
+	maxcnt_ps = (u64)maxcnt * 640000;
+	delay = REG_FIELD_GET(IDLE_DELAY, idledly);
+	if (xe_gt_WARN_ON(gt, (u64)delay * idledly_units_ps >= maxcnt_ps ||
+			  (idledly & INHIBIT_SWITCH_UNTIL_PREEMPTED))) {
+		/* Keep units in ps and round down to enforce the strict inequality. */
+		delay = min_t(u64, div_u64(maxcnt_ps - 1, idledly_units_ps),
+			      REG_FIELD_GET(IDLE_DELAY, IDLE_DELAY));
+		xe_mmio_rmw32(&gt->mmio, RING_IDLEDLY(hwe->mmio_base),
+			      IDLE_DELAY | INHIBIT_SWITCH_UNTIL_PREEMPTED,
+			      REG_FIELD_PREP(IDLE_DELAY, delay));
+	}
+}
